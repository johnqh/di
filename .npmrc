# @sudobility packages are hosted on GitHub Packages (not npmjs).
# Local installs need a GitHub token with read:packages exported as NODE_AUTH_TOKEN,
# e.g.  export NODE_AUTH_TOKEN=ghp_xxx   (or put the //npm.pkg.github.com/:_authToken line in ~/.npmrc)
# CI overwrites this file with the same routing using the built-in GITHUB_TOKEN.
@sudobility:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
